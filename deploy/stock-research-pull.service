[Unit]
Description=Pull stock-research from GitHub and publish the static site
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=stockdeploy
Group=stockdeploy
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/usr/local/bin/stock-research-pull
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/stock-research /var/www/stock-research

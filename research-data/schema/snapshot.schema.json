{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "研究数据快照 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "securityId", "dataset", "asOf", "collectedAt", "acceptance", "createdBy", "supersedes", "notes", "observations"],
  "properties": {
    "schemaVersion": {"enum": ["1.0"]},
    "snapshotId": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "securityId": {"type": "string", "pattern": "^(XSHG|XSHE|XHKG)\\.[0-9]{5,6}$"},
    "dataset": {"enum": ["quotes", "financials", "dividends", "operating", "events"]},
    "asOf": {"$ref": "#/$defs/date"},
    "collectedAt": {"$ref": "#/$defs/date"},
    "acceptance": {"enum": ["staging", "accepted", "rejected"]},
    "createdBy": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]},
    "notes": {"type": "string", "minLength": 1},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "period": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "start", "end"],
      "properties": {"kind": {"enum": ["instant", "duration", "event"]}, "start": {"type": ["string", "null"]}, "end": {"$ref": "#/$defs/date"}}
    },
    "basis": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "accountingStandard", "adjustment", "shareBasis"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "accountingStandard": {"type": "string", "minLength": 1},
        "adjustment": {"type": "string", "minLength": 1},
        "shareBasis": {"type": "string", "minLength": 1}
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["sourceId", "locator"],
      "properties": {"sourceId": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}}
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "metric", "value", "rawValue", "unit", "currency", "period", "basis", "nature", "verification", "precision", "missingReason", "sourceRefs", "notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "metric": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "value": {"type": ["string", "null"], "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        "rawValue": {"type": ["string", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "currency": {"enum": ["CNY", "HKD", "USD", null]},
        "period": {"$ref": "#/$defs/period"},
        "basis": {"$ref": "#/$defs/basis"},
        "nature": {"enum": ["historical_fact", "company_guidance", "external_forecast", "derived"]},
        "verification": {"enum": ["provider_reported", "source_extracted", "cross_checked", "conflicted", "missing"]},
        "precision": {"enum": ["as_reported", "vendor_rounded", "derived"]},
        "missingReason": {"type": ["string", "null"]},
        "sourceRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
        "notes": {"type": "string", "minLength": 1},
        "dimensions": {"type": "object", "additionalProperties": {"type": "string"}},
        "eventDetails": {
          "type": "object", "additionalProperties": false,
          "required": ["announcedAt", "approvedAt", "exDate", "paymentDate", "distributionStatus", "taxBasis", "fiscalPeriod"],
          "properties": {
            "announcedAt": {"type": ["string", "null"]},
            "approvedAt": {"type": ["string", "null"]},
            "exDate": {"type": ["string", "null"]},
            "paymentDate": {"type": ["string", "null"]},
            "distributionStatus": {"enum": ["proposed", "approved", "implemented", "cancelled", "unknown"]},
            "taxBasis": {"type": "string", "minLength": 1},
            "fiscalPeriod": {"type": "string", "minLength": 1}
          }
        },
        "derivation": {
          "type": "object", "additionalProperties": false, "required": ["formula", "inputs"],
          "properties": {"formula": {"type": "string", "minLength": 1}, "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
        }
      }
    }
  }
}
